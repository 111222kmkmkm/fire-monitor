{
  "name": "fire_monitor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:ui",
    "dev:ui": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "config:apply": "node ./scripts/apply-private-config.mjs",
    "config:github-actions": "node ./scripts/write-github-actions-config.mjs",
    "sync:data": "node ./scripts/sync-data.mjs",
    "sync:data:once": "node ./scripts/sync-data.mjs --once",
    "db:init": "node ./scripts/init-mobile-geodatabase.mjs",
    "process:himawari-fire": "python ./scripts/process-himawari-fire.py",
    "detect:himawari-fire": "node ./scripts/detect-himawari-fire.mjs",
    "cloud:pipeline": "node ./scripts/cloud-pipeline.mjs",
    "cloud:pipeline:once": "node ./scripts/cloud-pipeline.mjs --once",
    "pull:cloud-results": "node ./scripts/pull-cloud-results.mjs",
    "pull:cloud-results:once": "node ./scripts/pull-cloud-results.mjs --once"
  },
  "dependencies": {
    "@geoscene/core": "^4.33.19",
    "@maptiler/sdk": "^4.0.1",
    "@maptiler/weather": "^3.1.1",
    "grib-js": "^1.0.0",
    "grib2-simple": "^1.1.1",
    "ol": "^10.8.0",
    "vue": "^3.5.31"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^8.0.4",
    "typescript": "~6.0.0",
    "vite": "^8.0.3",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
