{
  "scheduleMinutes": 1,
  "dataRoot": "../相关数据/实时数据",
  "catalogOutput": "./public/data/catalog.json",
  "variables": {
    "WINDY_API_KEY": "replace-with-your-windy-point-forecast-key",
    "AOI_LON": "116.39",
    "AOI_LAT": "39.90"
  },
  "sources": [
    {
      "id": "himawari9_ahi_b03_b07_b13_b14",
      "name": "Himawari-9 AHI 可见光与热红外原始波段",
      "type": "noaa-aws-s3-himawari",
      "fallbackType": "jaxa-ftp-himawari",
      "enabled": false,
      "timeoutMs": 600000,
      "provider": "NOAA Open Data on AWS",
      "kind": "satellite-thermal",
      "targetDir": "himawari9_ahi",
      "keepSnapshots": 6,
      "publishLatest": false,
      "timelineMinutes": 10,
      "lookbackSlots": 2,
      "slotAvailabilityLagMinutes": 12,
      "requestTimeoutMs": 45000,
      "downloadTimeoutMs": 240000,
      "listMaxKeys": 1000,
      "maxParallelDownloads": 30,
      "bandParallelDownloads": 1,
      "bandDownloadTimeoutMs": 180000,
      "ftpFallbackBands": ["03"],
      "skipMd5WhenEtag": true,
      "progressLogEvery": 10,
      "retentionMinutes": 60,
      "storeFileBlobInDatabase": false,
      "bucket": "noaa-himawari9",
      "bucketRegion": "us-east-1",
      "productPrefix": "AHI-L1b-FLDK",
      "ftpBasePath": "/jma/hsd",
      "acqTimePattern": "(?<date>\\d{8})_(?<time>\\d{4})",
      "bands": ["03", "07", "13", "14"],
      "satellite": "H09",
      "sensor": "AHI",
      "roiCode": "CN",
      "databasePath": "./fire_monitor.geodatabase"
    },
    {
      "id": "windy_environment",
      "name": "Windy 火险环境场",
      "type": "windy-point-grid",
      "enabled": true,
      "provider": "Windy Point Forecast API",
      "kind": "environment-grid",
      "targetDir": "windy_environment",
      "keepSnapshots": 2,
      "publishLatest": true,
      "keyVariable": "WINDY_API_KEY",
      "model": "gfs",
      "leadHours": 3,
      "maxParallelRequests": 8,
      "requestTimeoutMs": 30000,
      "levels": ["surface"],
      "parameters": [
        "temp",
        "dewpoint",
        "rh",
        "wind",
        "windGust",
        "pressure",
        "precip",
        "convPrecip",
        "cape",
        "lclouds",
        "mclouds",
        "hclouds"
      ],
      "grid": {
        "minLat": -60,
        "maxLat": 75,
        "minLon": -180,
        "maxLon": 180,
        "stepLat": 20,
        "stepLon": 20
      },
      "apiUrl": "https://api.windy.com/api/point-forecast/v2"
    }
  ]
}
