{
  "scheduleMinutes": 1,
  "dataRoot": "../相关数据/实时数据",
  "catalogOutput": "./public/data/catalog.json",
  "variables": {
    "FIRMS_MAP_KEY": "replace-with-your-firms-key",
    "FIRMS_AREA": "world",
    "FIRMS_DAY_RANGE": "1",
    "WINDY_API_KEY": "replace-with-your-windy-key",
    "AOI_LON": "116.39",
    "AOI_LAT": "39.90"
  },
  "ftp": {
    "host": "ftp.ptree.jaxa.jp",
    "user": "replace-with-your-ftp-user",
    "password": "replace-with-your-ftp-password",
    "secure": false
  },
  "sources": [
    {
      "id": "himawari9_wlf",
      "name": "Himawari-9 活跃火点",
      "type": "ftp-latest",
      "enabled": true,
      "timeoutMs": 90000,
      "ftpTimeoutMs": 30000,
      "provider": "JAXA P-Tree",
      "kind": "fire-points",
      "targetDir": "himawari9_wlf",
      "keepSnapshots": 3,
      "publishLatest": true,
      "lookbackHours": 12,
      "remoteDirTemplate": "/pub/himawari/L2/WLF/010/{YYYYMM}/{DD}/{HH}",
      "filenamePattern": "^H09_\\d{8}_\\d{4}_L2WLF010_FLDK\\.\\d{5}_\\d{5}\\.csv$",
      "timestampPattern": "(?<date>\\d{8})_(?<time>\\d{4})"
    },
    {
      "id": "viirs_noaa20_nrt",
      "name": "VIIRS NOAA-20 活跃火点",
      "type": "http-single",
      "enabled": true,
      "timeoutMs": 60000,
      "provider": "NASA FIRMS",
      "kind": "fire-points",
      "targetDir": "viirs_noaa20_nrt",
      "keepSnapshots": 3,
      "publishLatest": true,
      "urlTemplate": "https://firms.modaps.eosdis.nasa.gov/api/area/csv/{FIRMS_MAP_KEY}/VIIRS_NOAA20_NRT/{FIRMS_AREA}/{FIRMS_DAY_RANGE}",
      "filenameTemplate": "viirs_noaa20_nrt_{YYYYMMDD}.csv"
    },
    {
      "id": "himawari9_ahi_b07_b13_b14",
      "name": "Himawari-9 AHI 可见光与热红外原始波段",
      "type": "noaa-aws-s3-himawari",
      "fallbackType": "jaxa-ftp-himawari",
      "enabled": true,
      "timeoutMs": 900000,
      "provider": "NOAA Open Data on AWS",
      "kind": "satellite-thermal",
      "targetDir": "himawari9_ahi",
      "keepSnapshots": 6,
      "publishLatest": false,
      "timelineMinutes": 10,
      "lookbackSlots": 2,
      "slotAvailabilityLagMinutes": 12,
      "requestTimeoutMs": 30000,
      "downloadTimeoutMs": 180000,
      "listMaxKeys": 1000,
      "maxParallelDownloads": 36,
      "bandParallelDownloads": 3,
      "bandDownloadTimeoutMs": 180000,
      "ftpFallbackBands": ["03"],
      "maxDownloadRetries": 2,
      "downloadRetryDelayMs": 500,
      "skipMd5WhenEtag": true,
      "progressLogEvery": 10,
      "bucket": "noaa-himawari9",
      "bucketRegion": "us-east-1",
      "productPrefix": "AHI-L1b-FLDK",
      "ftpBasePath": "/jma/hsd",
      "preferLatestCompleteSlot": true,
      "requireAllBandsInSlot": true,
      "targetSegments": ["01", "02", "03", "04"],
      "minSegmentsPerBand": 4,
      "deterministicSlotDownload": true,
      "skipMd5": true,
      "retentionMinutes": 60,
      "storeFileBlobInDatabase": false,
      "postProcessCommand": ["python", "./scripts/process-himawari-fire.py", "--config", "./.process-himawari-fire.config.json"],
      "postProcessOnceKey": "himawari-fire-latest",
      "postProcessFailureMode": "warn",
      "postProcessTimeoutMs": 600000,
      "acqTimePattern": "(?<date>\\d{8})_(?<time>\\d{4})",
      "bands": ["03", "07", "13", "14"],
      "satellite": "H09",
      "sensor": "AHI",
      "roiCode": "CN",
      "databasePath": "./fire_monitor.geodatabase"
    },
    {
      "id": "himawari9_ahi_b03",
      "name": "Himawari-9 AHI 可见光 B03",
      "type": "jaxa-ftp-himawari",
      "enabled": false,
      "timeoutMs": 900000,
      "provider": "JAXA P-Tree",
      "kind": "satellite-visible",
      "targetDir": "himawari9_ahi",
      "keepSnapshots": 6,
      "publishLatest": false,
      "timelineMinutes": 10,
      "lookbackSlots": 2,
      "requestTimeoutMs": 45000,
      "downloadTimeoutMs": 240000,
      "maxParallelDownloads": 6,
      "ftpBatchSize": 2,
      "bandParallelConnections": 2,
      "maxParallelConnections": 4,
      "maxDownloadRetries": 2,
      "downloadRetryDelayMs": 1000,
      "lowSpeedLimitBytes": 256,
      "lowSpeedTimeSeconds": 120,
      "progressLogEvery": 4,
      "ftpBasePath": "/jma/hsd",
      "preferLatestCompleteSlot": true,
      "requireAllBandsInSlot": true,
      "targetSegments": ["01", "02", "03", "04"],
      "minSegmentsPerBand": 4,
      "deterministicSlotDownload": true,
      "skipMd5": true,
      "retentionMinutes": 60,
      "storeFileBlobInDatabase": false,
      "postProcessCommand": ["python", "./scripts/process-himawari-fire.py", "--config", "./.process-himawari-fire.config.json"],
      "postProcessOnceKey": "himawari-fire-latest",
      "postProcessTimeoutMs": 600000,
      "acqTimePattern": "(?<date>\\d{8})_(?<time>\\d{4})",
      "bands": ["03"],
      "satellite": "H09",
      "sensor": "AHI",
      "roiCode": "CN",
      "databasePath": "./fire_monitor.geodatabase"
    },
    {
      "id": "windy_environment",
      "name": "Windy 火险环境场",
      "type": "windy-point-grid",
      "enabled": true,
      "provider": "Windy Point Forecast API",
      "kind": "environment-grid",
      "targetDir": "windy_environment",
      "keepSnapshots": 2,
      "publishLatest": true,
      "keyVariable": "WINDY_API_KEY",
      "model": "gfs",
      "leadHours": 3,
      "maxParallelRequests": 8,
      "requestTimeoutMs": 30000,
      "levels": ["surface"],
      "parameters": [
        "temp",
        "dewpoint",
        "rh",
        "wind",
        "windGust",
        "pressure",
        "precip",
        "convPrecip",
        "cape",
        "lclouds",
        "mclouds",
        "hclouds"
      ],
      "grid": {
        "minLat": 18,
        "maxLat": 54,
        "minLon": 73,
        "maxLon": 135.5,
        "stepLat": 4,
        "stepLon": 4
      },
      "apiUrl": "https://api.windy.com/api/point-forecast/v2"
    }
  ]
}
